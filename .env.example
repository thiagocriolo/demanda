# Copie este arquivo para .env e substitua os valores locais.
# Nunca versione a senha real do MySQL.
MYSQL_URL=mysql://demanda_app:troque-esta-senha@127.0.0.1:3306/demanda
APP_ORIGIN=http://localhost:5190

# Adapter Node e proxy devem aceitar o multipart de 15 MiB, sem liberar corpos arbitrários.
BODY_SIZE_LIMIT=16M

# Limites do pool usado por cada processo Node da aplicação.
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000

# Arquivos privados: disco persistente em desenvolvimento.
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=.data/uploads

# Em produção, use FILE_STORAGE_DRIVER=s3 e configure um bucket privado.
# S3_ENDPOINT=https://s3.seu-provedor.com
# S3_REGION=us-east-1
# S3_BUCKET=demanda-private
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
