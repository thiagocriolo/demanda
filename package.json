{
  "name": "demanda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run db:migrate && svelte-kit sync && vite build",
    "start": "node --env-file=.env build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrations:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed-mysql-local-users.ts",
    "db:seed:all-users": "tsx scripts/seed-mysql-local-users.ts",
    "db:seed:load": "tsx scripts/seed-load-test.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx scripts/check-mysql-database.ts",
    "db:check:mysql": "tsx scripts/check-mysql-database.ts",
    "db:check:postgresql-references": "tsx scripts/check-postgresql-references.ts",
    "db:verify": "tsx scripts/verify-core-data.ts",
    "db:verify:seed": "tsx scripts/verify-load-seed-scenario.ts",
    "media:cleanup": "tsx scripts/cleanup-private-media.ts",
    "media:migrate-legacy": "tsx scripts/migrate-legacy-images.ts",
    "verify:http:businesses": "tsx scripts/verify-business-http.ts",
    "verify:http:projects": "tsx scripts/verify-project-http.ts",
    "verify:http:tasks": "tsx scripts/verify-task-http.ts",
    "format": "prettier --plugin=prettier-plugin-svelte --write \"src/**/*\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.{json,js,ts}\"",
    "format:check": "prettier --plugin=prettier-plugin-svelte --check \"src/**/*\" \"scripts/**/*.ts\" \"tests/**/*.ts\" \"docs/**/*.md\" \"*.{json,js,ts}\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^20.17.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@lucide/svelte": "^1.24.0",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.6",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  }
}
